{
  "$comment": "generated by scripts/build.mjs; `relay setup codex <project>` installs this as <project>/.codex/hooks.json with __RELAY_ROOT__ resolved",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__RELAY_ROOT__/hooks/session-start.mjs\" --harness codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "spawn_agent|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__RELAY_ROOT__/hooks/codex-spawn.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|shell|exec_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__RELAY_ROOT__/hooks/retest-guard.mjs\""
          },
          {
            "type": "command",
            "command": "node \"__RELAY_ROOT__/hooks/protect-tests.mjs\""
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__RELAY_ROOT__/hooks/protect-tests.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|shell|exec_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__RELAY_ROOT__/hooks/retest-guard.mjs\""
          }
        ]
      }
    ]
  }
}
